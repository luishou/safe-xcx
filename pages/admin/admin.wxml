<!-- 监管中心管理界面 -->
<view class="manager-view">
    <!-- 顶部导航栏 -->
    <view class="top-nav">
        <view class="back-btn" bindtap="goBack">
            <text>← 返回</text>
        </view>
        <view class="nav-title">{{currentSection.section_name || ('第' + currentSection + '标段')}} - {{isAdmin ? '监管中心' : '举报公示'}}</view>
    </view>

    <!-- 顶部图标菜单：统计 / 举报列表（仅管理员可见） -->
    <view class="icon-menu" wx:if="{{isAdmin}}">
        <!-- 左侧：举报列表 -->
        <view class="icon-card {{currentPanel === 'tasks' ? 'selected' : ''}}" bindtap="showTasksPanel">
            <text class="icon-emoji">🗂️</text>
            <text class="icon-label">举报列表</text>
        </view>
        <!-- 右侧：统计 -->
        <view class="icon-card {{currentPanel === 'stats' ? 'selected' : ''}}" bindtap="showStatsPanel">
            <text class="icon-emoji">📈</text>
            <text class="icon-label">统计</text>
        </view>
        <!-- 安全知识管理入口 -->
        <view class="icon-card" bindtap="goKnowledgeAdmin">
            <text class="icon-emoji">📚</text>
            <text class="icon-label">安全知识</text>
        </view>
        <!-- 认证管理入口 -->
        <view class="icon-card" bindtap="goVerificationAdmin">
            <text class="icon-emoji">✅</text>
            <text class="icon-label">认证管理</text>
        </view>
    </view>

    <!-- 统计面板 -->
    <view class="stats-panel" wx:if="{{currentPanel === 'stats'}}">
        <!-- 筛选时间 -->
        <view class="filter-header">
            <view class="filter-bar">
                <view class="filter-option {{statsFilterType === 'all' ? 'active' : ''}}" data-type="all" bindtap="onChangeStatsFilter">全部</view>
                <view class="filter-option {{statsFilterType === 'month' ? 'active' : ''}}" data-type="month" bindtap="onChangeStatsFilter">近一月</view>
                <view class="filter-option {{statsFilterType === 'year' ? 'active' : ''}}" data-type="year" bindtap="onChangeStatsFilter">近一年</view>
                <view class="filter-option {{statsFilterType === 'custom' ? 'active' : ''}}" data-type="custom" bindtap="onChangeStatsFilter">自定义</view>
            </view>
            <view style="display:flex; gap:12rpx; align-items:center;">
                <view class="export-btn" bindtap="exportExcel">导出全部</view>
                <view class="refresh-btn" bindtap="refreshAllData">
                    <text>刷新数据</text>
                </view>
            </view>
        </view>

        <!-- 自定义日期范围选择 -->
        <view class="custom-range" wx:if="{{statsFilterType === 'custom'}}">
            <picker mode="date" value="{{customStartDate}}" bindchange="onStartDateChange">
                <view class="date-picker">开始日期：{{customStartDate || '请选择'}}</view>
            </picker>
            <picker mode="date" value="{{customEndDate}}" bindchange="onEndDateChange">
                <view class="date-picker">结束日期：{{customEndDate || '请选择'}}</view>
            </picker>
            <button class="apply-btn" bindtap="applyCustomFilter">应用</button>
        </view>

        <!-- 状态数量汇总 -->
        <view class="status-summary">
            <view class="summary-card pending">
                <view class="sum-label">待处理</view>
                <view class="sum-count">{{statsPendingCount}}</view>
            </view>
            <view class="summary-card processing">
                <view class="sum-label">处理中</view>
                <view class="sum-count">{{statsProcessingCount}}</view>
            </view>
            <view class="summary-card completed">
                <view class="sum-label">已办结</view>
                <view class="sum-count">{{statsCompletedCount}}</view>
            </view>
        </view>

        <!-- 概览指标 -->
        <view class="overview-row">
            <view class="overview-item">
                <view class="overview-label">总举报数</view>
                <view class="overview-value">{{totalReports}}</view>
            </view>
            <view class="overview-item">
                <view class="overview-label">解决率</view>
                <view class="overview-value">{{resolutionRate}}%</view>
            </view>
        </view>

        <!-- 隐患类型分布（饼图） -->
        <view class="hazard-chart-section">
            <view class="section-title">隐患类型分布</view>
            <view class="chart-container">
                <canvas class="pie-chart" canvas-id="adminPieChart" style="width: {{canvasWidth || 300}}px; height: {{canvasHeight || 300}}px;"></canvas>
                <view class="chart-legend" wx:if="{{hazardDistribution && hazardDistribution.length > 0}}">
                    <block wx:for="{{hazardDistribution}}" wx:key="name">
                        <view class="legend-item">
                            <view class="legend-color" style="background: {{item.color}};"></view>
                            <text class="legend-label">{{item.name}} {{item.percentage}}%</text>
                        </view>
                    </block>
                </view>
            </view>
        </view>
    </view>

    <!-- 举报列表统计概览（管理员可见） -->
    <view class="status-summary-row" wx:if="{{currentPanel === 'tasks' && isAdmin}}">
        <text class="total-count">共 {{allReports.length}} 条举报记录</text>
    </view>

    <!-- 举报工单列表 -->
    <view class="reports-container" wx:if="{{currentPanel === 'tasks' || !isAdmin}}">
        <!-- 管理员：显示所有状态的举报列表 -->
        <block wx:if="{{isAdmin}}">
            <view class="reports-list public-list">
                <view wx:for="{{allReports}}" wx:key="id" class="report-item {{item.statusClass}}" bindtap="showReportDetail" data-id="{{item.id}}">
                    <view class="item-header">
                        <view class="item-type" style="background: {{item.hazardTypeColor}};">{{item.hazardType}}</view>
                        <view class="item-status {{item.statusClass}}">{{item.statusText}}</view>
                    </view>
                    <view class="item-desc">{{item.description}}</view>
                    <view class="item-meta">
                        <text class="reporter">举报人: {{item.reporter}}</text>
                        <text class="time">{{item.reportTime}}</text>
                    </view>
                </view>
                <view class="empty-state" wx:if="{{allReports.length === 0}}">
                    <text class="empty-text">暂无举报记录</text>
                </view>
            </view>
        </block>

        <!-- 举报公示：显示所有状态的统一列表 -->
        <block wx:if="{{!isAdmin}}">
            <view class="reports-list public-list">
                <view wx:for="{{allReports}}" wx:key="id" class="report-item {{item.statusClass}}" bindtap="showReportDetail" data-id="{{item.id}}">
                    <view class="item-header">
                        <view class="item-type" style="background: {{item.hazardTypeColor}};">{{item.hazardType}}</view>
                        <view class="item-status {{item.statusClass}}">{{item.statusText}}</view>
                    </view>
                    <view class="item-desc">{{item.description}}</view>
                    <view class="item-meta">
                        <text class="time">{{item.reportTime}}</text>
                    </view>
                </view>
                <view class="empty-state" wx:if="{{allReports.length === 0}}">
                    <text class="empty-text">暂无举报记录</text>
                </view>
            </view>
        </block>

        <!-- 加载状态 -->
        <view class="loading" wx:if="{{loading}}">
            <text>加载中...</text>
        </view>
    </view>
</view>