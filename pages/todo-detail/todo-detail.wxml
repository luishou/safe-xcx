<!-- 待办详情页面 -->
<view class="todo-detail-page">
    <view class="header">
        <view class="back-btn" bindtap="goBack">
            <text>← 返回</text>
        </view>
        <view class="title">待办详情</view>
    </view>

    <!-- 加载状态 -->
    <view class="loading" wx:if="{{loading}}">
        <text>加载中...</text>
    </view>

    <!-- 错误状态 -->
    <view class="error" wx:if="{{error}}">
        <text>{{error}}</text>
        <button class="retry-btn" bindtap="loadReportDetail">重试</button>
    </view>

    <!-- 举报内容 -->
    <view wx:if="{{report && !loading && !error}}">
        <!-- 隐患详情 -->
        <view class="info-section">
            <view class="info-header">
                <view class="report-id">隐患详情 #{{report.id}}</view>
            </view>

            <view class="info-content">
                <view class="info-row">
                    <text class="info-label">隐患类型：</text>
                    <text class="info-value">{{report.hazard_type_cn}}</text>
                </view>
                <view class="info-row">
                    <text class="info-label">紧急程度：</text>
                    <text class="info-value severity-{{report.severity}}">{{report.severity_cn}}</text>
                </view>
                <view class="info-row">
                    <text class="info-label">所在位置：</text>
                    <text class="info-value">{{report.location}}</text>
                </view>
                <view class="info-row">
                    <text class="info-label">所属标段：</text>
                    <text class="info-value">{{report.section}}</text>
                </view>
                <view class="info-row">
                    <text class="info-label">举报人：</text>
                    <text class="info-value">{{report.reporter_name}}</text>
                </view>
                <view class="info-row">
                    <text class="info-label">举报时间：</text>
                    <text class="info-value">{{report.created_at}}</text>
                </view>
                <view class="info-row description-row">
                    <text class="info-label">隐患描述：</text>
                    <text class="info-value description-text">{{report.description}}</text>
                </view>
            </view>
        </view>

        <!-- 现场照片 -->
        <view class="photos-section">
            <view class="section-title">现场照片</view>
            <view wx:if="{{report.initial_images && report.initial_images.length > 0}}">
                <view class="photos-grid">
                    <view wx:for="{{report.initial_images}}" wx:key="*this" class="photo-item" bindtap="viewImage" data-src="{{item}}" data-list="{{report.initial_images}}">
                        <image src="{{item}}" mode="aspectFill" class="photo"></image>
                    </view>
                </view>
            </view>
            <view class="photos-empty" wx:if="{{!report.initial_images || report.initial_images.length === 0}}">
                <text>暂无现场照片</text>
            </view>
        </view>

        <!-- 处理信息 / 驳回信息 -->
        <view class="info-section" wx:if="{{report.processing_opinion || report.reward_amount}}">
            <view class="section-title">{{(currentStatus === 'submitted' && report.supervisor_comment) ? '驳回信息' : '处理信息'}}</view>
            <view class="info-content">
                <view class="info-row" wx:if="{{currentStatus === 'submitted' && report.supervisor_comment}}">
                    <text class="info-label" style="color:#ef4444;font-weight:bold;">驳回原因：</text>
                    <text class="info-value" style="color:#ef4444;font-weight:bold;">{{report.supervisor_comment}}</text>
                </view>
                <view class="info-row" wx:if="{{report.processor_name}}">
                    <text class="info-label">处理人员：</text>
                    <text class="info-value">{{report.processor_name}}</text>
                </view>
                <view class="info-row" wx:if="{{report.processing_opinion}}">
                    <text class="info-label">处理意见：</text>
                    <text class="info-value">{{report.processing_opinion}}</text>
                </view>
                <view class="info-row" wx:if="{{report.reward_amount}}">
                    <text class="info-label">奖金金额：</text>
                    <text class="info-value" style="color:#ff6b35;font-weight:bold;">¥{{report.reward_amount}}</text>
                </view>
            </view>
        </view>

        <!-- 监理确认信息 -->
        <view class="info-section" wx:if="{{report.supervisor_name || report.supervisor_comment}}">
            <view class="section-title">{{(currentStatus === 'submitted' && report.supervisor_comment) ? '监理驳回信息' : '监理确认'}}</view>
            <view class="info-content">
                <view class="info-row" wx:if="{{report.supervisor_name}}">
                    <text class="info-label">监理人员：</text>
                    <text class="info-value">{{report.supervisor_name}}</text>
                </view>
                <view class="info-row" wx:if="{{report.supervisor_confirmed_at}}">
                    <text class="info-label">确认时间：</text>
                    <text class="info-value">{{report.supervisor_confirmed_at}}</text>
                </view>
                <view class="info-row" wx:if="{{report.supervisor_comment}}">
                    <text class="info-label">监理意见：</text>
                    <text class="info-value">{{report.supervisor_comment}}</text>
                </view>
            </view>
        </view>

        <!-- 整改照片（有数据时显示） -->
        <view class="photos-section" wx:if="{{report.rectified_images && report.rectified_images.length > 0}}">
            <view class="section-title">整改照片</view>
            <view class="photos-grid">
                <view wx:for="{{report.rectified_images}}" wx:key="*this" class="photo-item" bindtap="viewImage" data-src="{{item}}">
                    <image src="{{item}}" mode="aspectFill" class="photo"></image>
                </view>
            </view>
        </view>

        <!-- ==================== 操作区域 ==================== -->

        <!-- 待处理状态 - 安全部确认（填写意见+奖金） -->
        <view class="actions-section" wx:if="{{currentStatus === 'submitted'}}">
            <view class="section-title">安全部处理</view>
            
            <!-- 初始操作按钮 -->
            <view class="action-buttons" wx:if="{{!showConfirmForm}}">
                <button class="action-btn confirm-btn" bindtap="showConfirmDialog">
                    <text class="btn-text">确认处理</text>
                </button>
                <button class="action-btn reject-btn" bindtap="rejectReport">
                    <text class="btn-text">驳回办结</text>
                </button>
            </view>

            <!-- 确认表单 -->
            <view wx:if="{{showConfirmForm}}">
                <view class="input-section">
                    <view class="input-title">处理意见 <text class="required">*</text></view>
                    <textarea class="plan-textarea" placeholder="请填写处理意见..." value="{{processingOpinion}}" bindinput="onOpinionInput" maxlength="500" auto-height></textarea>
                </view>

                <view class="input-section">
                    <view class="input-title">奖金金额（元） <text class="required">*</text></view>
                    <input class="reward-input" type="digit" placeholder="请输入奖金金额" value="{{rewardAmount}}" bindinput="onRewardInput"/>
                </view>

                <view class="action-buttons">
                    <button class="action-btn confirm-btn" bindtap="confirmReport">
                        <text class="btn-text">提交确认</text>
                    </button>
                    <button class="action-btn cancel-btn" bindtap="cancelConfirm" style="background:#9ca3af;color:white;">
                        <text class="btn-text">取消</text>
                    </button>
                </view>
            </view>
        </view>

        <!-- 待监理确认状态 - 监理操作 -->
        <view class="actions-section" wx:if="{{currentStatus === 'confirmed' && isSupervisor}}">
            <view class="section-title">监理确认</view>
            
            <view class="input-section">
                <view class="input-title">监理意见 <text class="required">*</text></view>
                <textarea class="plan-textarea" placeholder="请填写监理意见..." value="{{supervisorComment}}" bindinput="onSupervisorCommentInput" maxlength="200" auto-height></textarea>
            </view>

            <view class="action-buttons">
                <button class="action-btn confirm-btn" bindtap="supervisorConfirmReport">
                    <text class="btn-text">确认通过</text>
                </button>
                <button class="action-btn reject-btn" bindtap="supervisorRejectReport">
                    <text class="btn-text">驳回</text>
                </button>
            </view>
        </view>

        <!-- 待整改状态 - 安全部上传处理照片 -->
        <view class="actions-section" wx:if="{{currentStatus === 'supervisor_confirmed'}}">
            <view class="section-title">上传整改照片</view>
            
            <view class="upload-section">
                <view class="upload-photos">
                    <view wx:for="{{rectifiedImages}}" wx:key="index" class="uploaded-photo">
                        <image src="{{item}}" mode="aspectFill" class="photo"></image>
                        <view class="remove-btn" bindtap="removeRectifiedPhoto" data-index="{{index}}">×</view>
                    </view>
                    <view class="add-photo" bindtap="addRectifiedPhoto" wx:if="{{rectifiedImages.length < 3}}">
                        <text class="add-icon">+</text>
                        <text class="add-text">添加照片</text>
                    </view>
                </view>
                <view class="upload-tip">最多可上传3张照片</view>
            </view>

            <button class="action-btn confirm-btn" bindtap="uploadProcessPhotos">
                <text class="btn-text">提交整改照片</text>
            </button>
        </view>

        <!-- 待下发奖金状态 - 安全部上传奖金截图 -->
        <view class="actions-section" wx:if="{{currentStatus === 'photo_uploaded'}}">
            <view class="section-title">上传奖金发放截图</view>
            
            <view class="upload-section">
                <view class="upload-photos">
                    <view wx:for="{{rewardImages}}" wx:key="index" class="uploaded-photo">
                        <image src="{{item}}" mode="aspectFill" class="photo"></image>
                        <view class="remove-btn" bindtap="removeRewardPhoto" data-index="{{index}}">×</view>
                    </view>
                    <view class="add-photo" bindtap="addRewardPhoto" wx:if="{{rewardImages.length < 3}}">
                        <text class="add-icon">+</text>
                        <text class="add-text">添加截图</text>
                    </view>
                </view>
                <view class="upload-tip">最多可上传3张截图</view>
            </view>

            <button class="action-btn confirm-btn" bindtap="uploadRewardProof">
                <text class="btn-text">提交截图并办结</text>
            </button>
        </view>

    </view>
</view>
