<!-- 任务管理页面 -->
<view class="profile-page">
    <!-- 用户信息头部 -->
    <view class="user-header">
        <view class="user-name">{{currentUser.name || '用户'}}</view>
        <view class="user-section">第{{currentSection.section_code || currentSection}}标段</view>
    </view>

    <!-- Tab切换 -->
    <view class="tabs">
        <view class="tab {{activeTab === 'todo' ? 'active' : ''}}" bindtap="switchTab" data-tab="todo">
            <text>我的待办</text>
            <view class="badge" wx:if="{{todoCount > 0}}">{{todoCount}}</view>
        </view>
        <view class="tab {{activeTab === 'reports' ? 'active' : ''}}" bindtap="switchTab" data-tab="reports">
            <text>我的举报</text>
            <view class="badge" wx:if="{{myReportsCount > 0}}">{{myReportsCount}}</view>
        </view>
    </view>

    <!-- 列表内容区域 -->
    <view class="list-container">
        <!-- 待办列表 -->
        <block wx:if="{{activeTab === 'todo'}}">
            <view class="loading-state" wx:if="{{isLoadingTodo}}">加载中...</view>
            <view class="empty-state" wx:elif="{{todoReports.length === 0}}">
                <text>暂无待办事项</text>
            </view>
            <view wx:else class="report-list">
                <view class="report-item todo-card" wx:for="{{todoReports}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
                    <view class="card-header">
                        <text class="hazard-type">{{item.hazard_type_cn}}</text>
                        <text class="status-tag status-{{item.status}}">{{item.status_cn}}</text>
                    </view>
                    <view class="card-content">
                        <text class="description">{{item.description}}</text>
                    </view>
                    <view class="card-footer">
                        <text class="location">📍 {{item.location}}</text>
                        <text class="time">{{item.updated_at}}</text>
                    </view>
                </view>
            </view>
        </block>

        <!-- 我的举报列表 -->
        <block wx:if="{{activeTab === 'reports'}}">
            <view class="loading-state" wx:if="{{isLoadingMyReports}}">加载中...</view>
            <view class="empty-state" wx:elif="{{myReports.length === 0}}">
                <text>暂无举报记录</text>
            </view>
            <view wx:else class="report-list">
                <view class="report-item" wx:for="{{myReports}}" wx:key="id" bindtap="goToReadonlyDetail" data-id="{{item.id}}">
                    <view class="card-header">
                        <text class="hazard-type">{{item.hazard_type_cn}}</text>
                        <text class="status-tag status-{{item.status}}">{{item.status_cn}}</text>
                    </view>
                    <view class="card-content">
                        <text class="description">{{item.description}}</text>
                    </view>
                    <view class="card-footer">
                        <text class="location">📍 {{item.location}}</text>
                        <text class="time">{{item.created_at_short}}</text>
                    </view>
                </view>
            </view>
        </block>
    </view>
</view>