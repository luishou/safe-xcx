/* 个人中心页面 */
.profile-page {
    min-height: 100vh;
    background: #f8f9fa;
    padding-bottom: 40rpx;
}

/* 用户信息头部 */
.user-header {
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    padding: 60rpx 32rpx 40rpx;
    color: white;
    text-align: center;
}

.user-name {
    font-size: 40rpx;
    font-weight: bold;
    margin-bottom: 12rpx;
}

.user-section {
    font-size: 28rpx;
    opacity: 0.9;
}

/* Tab切换 */
.tabs {
    display: flex;
    margin: 24rpx 32rpx;
    background: white;
    border-radius: 16rpx;
    padding: 8rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.tab {
    flex: 1;
    text-align: center;
    padding: 24rpx 0;
    font-size: 28rpx;
    color: #6b7280;
    border-radius: 12rpx;
    position: relative;
    transition: all 0.3s;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8rpx;
}

.tab.active {
    background: #eef2ff;
    color: #4f46e5;
    font-weight: bold;
}

.badge {
    background: #ef4444;
    color: white;
    font-size: 20rpx;
    padding: 2rpx 10rpx;
    border-radius: 20rpx;
    min-width: 28rpx;
    text-align: center;
    line-height: 1.2;
}

/* 列表容器 */
.list-container {
    margin: 0 32rpx 32rpx;
    min-height: 200rpx;
}

.loading-state, .empty-state {
    text-align: center;
    padding: 60rpx 0;
    color: #9ca3af;
    font-size: 28rpx;
    background: white;
    border-radius: 16rpx;
}

/* 列表项样式 */
.report-list {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.report-item {
    background: white;
    border-radius: 16rpx;
    padding: 32rpx;
    box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}

.todo-card {
    border-left: 6rpx solid #f59e0b;
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
}

.hazard-type {
    font-size: 30rpx;
    font-weight: bold;
    color: #1f2937;
}

.status-tag {
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
}

.status-submitted { background: #fef3c7; color: #d97706; }
.status-confirmed { background: #fee2e2; color: #b91c1c; }
.status-supervisor_confirmed { background: #e0e7ff; color: #4338ca; }
.status-photo_uploaded { background: #dcfce7; color: #15803d; }
.status-completed { background: #f3f4f6; color: #6b7280; }

.card-content {
    margin-bottom: 20rpx;
}

.description {
    font-size: 28rpx;
    color: #4b5563;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 24rpx;
    color: #9ca3af;
    border-top: 1px solid #f3f4f6;
    padding-top: 16rpx;
}

.location {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.time {
    margin-left: 16rpx;
    white-space: nowrap;
}