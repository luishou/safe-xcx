/* pages/verification-admin/verification-admin.wxss */
.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部返回栏 */
.header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: white;
  border-bottom: 2rpx solid #f3f4f6;
}

.back-btn {
  font-size: 28rpx;
  color: #667eea;
  padding: 8rpx 0;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #111827;
  margin-right: 80rpx; /* 平衡返回按钮的宽度 */
}

/* 标签页 */
.tabs {
  display: flex;
  background: white;
  padding: 0 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #667eea;
  font-weight: bold;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

/* 用户列表 */
.user-list {
  padding: 24rpx 32rpx;
}

.loading,
.empty {
  text-align: center;
  padding: 120rpx 0;
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 用户项 */
.user-item {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.user-item.verified {
  border-left: 8rpx solid #10b981;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-details {
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #111827;
  margin-right: 16rpx;
}

.verified-badge {
  padding: 4rpx 16rpx;
  background: #d1fae5;
  color: #10b981;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.real-name {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.submitted-name {
  font-size: 26rpx;
  color: #059669;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.user-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #6b7280;
}

.user-section {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  display: inline-block;
}

/* 操作按钮 */
.user-actions {
  display: flex;
  gap: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f3f4f6;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.action-btn::after {
  border: none;
}

/* 自定义认证弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 600rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 2rpx solid #f3f4f6;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #111827;
}

.modal-content {
  padding: 32rpx;
}

.modal-field {
  margin-bottom: 32rpx;
}

.modal-field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.field-label.required::after {
  content: ' *';
  color: #ef4444;
}

.field-display {
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #111827;
  font-weight: 500;
}

.field-display.submitted {
  background: #ecfdf5;
  color: #059669;
}

.field-input {
  width: 100%;
  padding: 32rpx 24rpx;  /* 增加垂直内边距 */
  min-height: 88rpx;     /* 设置最小高度 */
  background: white;
  border: 2rpx solid #e5e7eb;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

.field-input:focus {
  border-color: #667eea;
}

.field-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #f3f4f6;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border: none;
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 500;
  background: white;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  color: #6b7280;
  border-right: 2rpx solid #f3f4f6;
}

.modal-btn.confirm {
  color: #667eea;
  font-weight: bold;
}
