<!--pages/verification/verification.wxml-->
<view class="verification-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">用户认证</text>
    <text class="page-subtitle">完成认证后即可在该标段提交举报</text>
  </view>

  <!-- 标段选择 -->
  <view class="section-picker">
    <text class="picker-label">{{sectionLocked ? '认证标段' : '选择标段'}}</text>
    <!-- 锁定状态：显示只读标段名 -->
    <view wx:if="{{sectionLocked}}" class="picker-value locked">
      <text>{{currentSection.section_name || '加载中...'}}</text>
      <text class="lock-icon">🔒</text>
    </view>
    <!-- 非锁定状态：可选择标段 -->
    <picker
      wx:else
      mode="selector"
      range="{{sections}}"
      range-key="section_name"
      value="{{sectionIndex}}"
      bindchange="onSectionChange"
    >
      <view class="picker-value">
        <text>{{currentSection.section_name || '请选择标段'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 当前标段认证状态 -->
  <view wx:if="{{currentSection}}" class="status-container">
    <!-- 未申请状态 -->
    <view wx:if="{{currentVerification.status === 'none'}}" class="status-section">
      <view class="status-icon none">📋</view>
      <text class="status-title">未认证</text>
      <text class="status-desc">您在该标段尚未认证，请填写真实姓名并提交认证申请</text>
      
      <!-- 真实姓名输入 -->
      <view class="form-item">
        <text class="form-label required">真实姓名</text>
        <input
          class="form-input"
          placeholder="请输入真实姓名（2-10个中文字符）"
          value="{{realName}}"
          bindinput="onRealNameInput"
          maxlength="10"
        />
      </view>
      
      <button
        class="submit-btn {{isSubmitting ? 'disabled' : ''}}"
        bindtap="submitVerification"
        disabled="{{isSubmitting}}"
      >
        {{isSubmitting ? '提交中...' : '提交认证申请'}}
      </button>

      <view class="tips">
        <text class="tips-title">温馨提示：</text>
        <text class="tips-text">• 请填写真实有效的姓名</text>
        <text class="tips-text">• 管理员审核时可能会核实或修改姓名</text>
        <text class="tips-text">• 审核通过后即可在该标段提交隐患举报</text>
        <text class="tips-text">• 不同标段需分别认证</text>
      </view>
    </view>

    <!-- 待审核状态 -->
    <view wx:if="{{currentVerification.status === 'pending'}}" class="status-section">
      <view class="status-icon pending">⏳</view>
      <text class="status-title">审核中</text>
      <text class="status-desc">您在{{currentSection.section_name}}的认证申请正在审核中</text>
      <view class="pending-info">
        <view class="info-row">
          <text class="info-label">提交姓名：</text>
          <text class="info-value">{{currentVerification.realName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">申请时间：</text>
          <text class="info-value">{{currentVerification.submittedAt}}</text>
        </view>
      </view>
    </view>

    <!-- 已通过状态 -->
    <view wx:if="{{currentVerification.status === 'approved'}}" class="status-section">
      <view class="status-icon approved">✓</view>
      <text class="status-title">已认证</text>
      <text class="status-desc">您已在{{currentSection.section_name}}完成认证</text>
      <view class="verified-info">
        <view class="info-row">
          <text class="info-label">真实姓名：</text>
          <text class="info-value">{{currentVerification.realName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">认证时间：</text>
          <text class="info-value">{{currentVerification.reviewedAt}}</text>
        </view>
      </view>
    </view>

    <!-- 已拒绝状态 -->
    <view wx:if="{{currentVerification.status === 'rejected'}}" class="status-section">
      <view class="status-icon rejected">✕</view>
      <text class="status-title">认证未通过</text>
      <text class="status-desc">您在{{currentSection.section_name}}的认证申请未通过</text>
      <view wx:if="{{currentVerification.rejectReason}}" class="reject-reason">
        <text class="reason-title">拒绝原因：</text>
        <text class="reason-text">{{currentVerification.rejectReason}}</text>
      </view>
      
      <!-- 重新申请时填写姓名 -->
      <view class="form-item">
        <text class="form-label required">真实姓名</text>
        <input
          class="form-input"
          placeholder="请输入真实姓名（2-10个中文字符）"
          value="{{realName}}"
          bindinput="onRealNameInput"
          maxlength="10"
        />
      </view>
      
      <button class="reapply-btn" bindtap="submitVerification">重新申请</button>
    </view>
  </view>

  <!-- 所有标段认证概览 -->
  <view wx:if="{{verifications.length > 0}}" class="overview-section">
    <text class="overview-title">认证概览</text>
    <view class="overview-list">
      <view 
        wx:for="{{verifications}}" 
        wx:key="sectionCode" 
        class="overview-item {{item.status}}"
        bindtap="selectSection"
        data-section-code="{{item.sectionCode}}"
      >
        <text class="overview-name">{{item.sectionName}}</text>
        <text class="overview-status">
          {{item.status === 'approved' ? '已认证' : item.status === 'pending' ? '审核中' : item.status === 'rejected' ? '未通过' : '未认证'}}
        </text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>
</view>
